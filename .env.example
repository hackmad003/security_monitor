# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/security_monitor
MONGO_DB_NAME=security_monitor

# Email Alert Configuration
EMAIL_ENABLED=true
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@example.com
EMAIL_PASSWORD=your-app-specific-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Alert Thresholds
FAILED_LOGIN_THRESHOLD=5
PRIVILEGE_ESCALATION_THRESHOLD=3
ALERT_WINDOW_MINUTES=15

# Dashboard Configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false

# Security Certificates
CERT_PATH=./config/certs/security_cert.pem

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/security_monitor.log

# Windows Event Log
EVENT_LOG_NAME=Security
MONITOR_INTERVAL_SECONDS=60