ALERT_RESET_INTERVAL_HOURS=1

# ==========================================
# MONITORING SETTINGS
# ==========================================
REALTIME_INTERVAL_SECONDS=10
EVENTS_PER_CHECK=5000
DEFAULT_EVENT_COUNT=5000